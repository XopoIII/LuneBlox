--!strict
--[[
	Generates `crates/lune-roblox/src/datatypes/types/enum_legacy_names.rs`: the names an
	enum item used to have and that Roblox still accepts.

	When Roblox renames an enum item it keeps the old name working - `Enum.KeyCode.Unknown`
	is `Enum.KeyCode.None` under its former name. The reflection database only carries the
	current names, so without this table a database update breaks scripts Roblox still runs.

	Run from the repository root:

		luneblox run scripts/generate_enum_legacy_names.luau
]]

local fs = require("@lune/fs")
local net = require("@lune/net")
local serde = require("@lune/serde")

local VERSION_URL = "https://clientsettingscdn.roblox.com/v2/client-version/WindowsStudio64"
local DUMP_URL = "https://setup.rbxcdn.com/%s-API-Dump.json"
local OUTPUT = "crates/lune-roblox/src/datatypes/types/enum_legacy_names.rs"

local studio = serde.decode("json", net.request(VERSION_URL).body)
local dump =
	serde.decode("json", net.request(string.format(DUMP_URL, studio.clientVersionUpload)).body)

local entries = {}
for _, enum in dump.Enums do
	for _, item in enum.Items do
		for _, legacyName in item.LegacyNames or {} do
			table.insert(entries, { enum = enum.Name, legacy = legacyName, name = item.Name })
		end
	end
end
table.sort(entries, function(a, b)
	if a.enum ~= b.enum then
		return a.enum < b.enum
	end
	return a.legacy < b.legacy
end)

local contents = ""
contents ..= "// @generated by scripts/generate_enum_legacy_names.luau -- do not edit by hand.\n"
contents ..= "//\n"
contents ..= `// Former names of enum items as Roblox Studio {studio.version} still accepts them.\n`
contents ..= "// Regenerate when the reflection database moves.\n\n"
contents ..= "/// An enum, a former name of one of its items, and the name that item has now.\n"
contents ..= "pub(crate) const ENUM_ITEM_LEGACY_NAMES: &[(&str, &str, &str)] = &[\n"
for _, entry in entries do
	contents ..= string.format('    ("%s", "%s", "%s"),\n', entry.enum, entry.legacy, entry.name)
end
contents ..= "];\n"

fs.writeFile(OUTPUT, contents)
print(`Wrote {#entries} legacy enum item names for Roblox Studio {studio.version}`)
